function setupTriggerDistribute() {
  const ui = SpreadsheetApp.getUi();
  const resp = ui.prompt('Set Distribute Trigger', 'Enter time in HH:MM format (24hr clock):', ui.ButtonSet.OK_CANCEL);
  if (resp.getSelectedButton() !== ui.Button.OK) return;

  const timeParts = resp.getResponseText().trim().split(':');
  const hour = parseInt(timeParts[0], 10);
  const minute = parseInt(timeParts[1] || '0', 10);

  if (isNaN(hour) || hour < 0 || hour > 23 || isNaN(minute) || minute < 0 || minute > 59) {
    ui.alert('❌ Invalid time. Use 24hr format like 10:00 or 17:45');
    return;
  }

  // Remove old trigger
  ScriptApp.getProjectTriggers().forEach(t => {
    if (t.getHandlerFunction() === 'dailyDistributeJob_') ScriptApp.deleteTrigger(t);
  });

  // Set new trigger (only hour supported)
  ScriptApp.newTrigger('dailyDistributeJob_').timeBased().atHour(hour).everyDays(1).create();

  ui.alert(`✅ Distribute trigger set for ${hour}:00 (minutes not supported by Apps Script, skipping Sundays).`);
}

