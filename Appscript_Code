/* ---- Detect SourceData columns (flex headers) ---- */
function detectSourceCols_(srcHeaders){
  const H = srcHeaders.map(h=>norm_(h));
  function idxOf(keys){
    for(const k of keys){ const i = H.indexOf(k); if(i>-1) return i; }
    return -1;
  }
  return {
    date:  idxOf(['date','lead date','submitted at']),
    name:  idxOf(['full name','name']),
    phone: idxOf(['phone','phone number','mobile','mobile number','contact']),
    perHr: idxOf(['per hr shoot']),
    content: idxOf(['content you are planing']),
    editing: idxOf(['do you need editing services'])
  };
}

function ensureNotPickedSheet_(){
  const ss = SpreadsheetApp.getActive();
  let np = ss.getSheetByName(SHEET_NOT_PICKED);
  if(!np){
    const tr = ss.getSheetByName(SHEET_TRACKER);
    if(!tr) throw new Error('LeadTracker sheet missing.');
    const hdr = tr.getRange(1,1,1,tr.getLastColumn()).getValues();
    np = ss.insertSheet(SHEET_NOT_PICKED);
    np.getRange(1,1,1,hdr[0].length).setValues(hdr); // if creating fresh, copy headers
  }
  return np;
}

/* 🔧 NEW: header helpers (support different column orders per sheet) */
function getHeaderMap_(sheet){
  if(!sheet) return null;
  const lastCol = sheet.getLastColumn();
  if(lastCol < 1) return null;
  const hdr = sheet.getRange(1,1,1,lastCol).getValues()[0];
  return { headers: hdr, cmap: colmap_(hdr) };
}

function getPrevAllocationCountInSheet_(phone, sheet){
  if(!sheet) return 0;
  const hm = getHeaderMap_(sheet);
  if(!hm) return 0;
  const phCol = hm.cmap['phone'];
  const acCol = hm.cmap['allocation count'];
  if(phCol==null || acCol==null) return 0;

  const last = sheet.getLastRow();
  if(last < 2) return 0;
  const vals = sheet.getRange(2,1,last-1, sheet.getLastColumn()).getValues();

  let maxCount = 0;
  for(const r of vals){
    const ph = String(r[phCol]||'').trim();
    if(ph && ph === phone){
      const c = parseInt(r[acCol]||'0',10);
      if(c > maxCount) maxCount = c;
    }
  }
  return maxCount;
}

function getPrevAllocationCountAcross_(phone, trk, np){
  return Math.max(
    getPrevAllocationCountInSheet_(phone, trk),
    getPrevAllocationCountInSheet_(phone, np)
  );
}

/* 🔧 Parse max numeric part from any sheet's "Lead ID" column */
function getMaxLeadSeqFromSheet_(sheet, leadIdColZero){
  if(!sheet) return 0;
  const lastRow = sheet.getLastRow();
  if(lastRow < 2) return 0;
  const vals = sheet.getRange(2, leadIdColZero+1, lastRow-1, 1).getValues().flat();
  let maxSeq = 0;
  const re = new RegExp('^' + LEAD_ID_PREFIX.replace(/[-/\\^$*+?.()|[\]{}]/g, '\\$&') + '(\\d+)$');
  for(const v of vals){
    const s = String(v||'').trim();
    const m = s.match(re);
    if(m){
      const n = parseInt(m[1], 10);
      if(n > maxSeq) maxSeq = n;
    }
  }
  return maxSeq;
}

/* 🔧 Compute the next starting sequence across BOTH sheets */
function getNextLeadSeq_(trk, np, tmap){
  const leadIdColZero = tmap['lead id'];
  let maxSeq = 0;
  maxSeq = Math.max(maxSeq, getMaxLeadSeqFromSheet_(trk, leadIdColZero));
  maxSeq = Math.max(maxSeq, getMaxLeadSeqFromSheet_(np, leadIdColZero));
  return maxSeq + 1; // next available
}

/* 🔧 format helper */
function formatLeadId_(seq){
  return LEAD_ID_PREFIX + Utilities.formatString('%0' + LEAD_ID_PAD + 'd', seq);
}

/* =============== A) DISTRIBUTE NEW ONLY ================= */
function distributeNewLeads(){
  const lock = LockService.getDocumentLock(); // prevent concurrent ID allocation clashes
  lock.waitLock(20000); // up to 20s

  try{
    const ss = SpreadsheetApp.getActive();
    const src = ss.getSheetByName(SHEET_SOURCE);
    const trk = ss.getSheetByName(SHEET_TRACKER);
    if(!src || !trk) throw new Error('SourceData or LeadTracker sheet missing.');

    const srcVals = src.getDataRange().getValues();
    if(srcVals.length < 2) return;

    const trkVals = trk.getDataRange().getValues();
    const trkHdr = trkVals[0];
    const tmap = colmap_(trkHdr);

    // ✅ require Allocation Count too
    const need = [
      'date','lead id','name','phone','per hr shoot','content you are planing','do you need editing services',
      'allocation date','sales person','call status','calling date',
      'remark 1','date 1','remark 2','date 2','remark 3','date 3',
      'remark 4','date 4','remark 5','date 5',
      'allocation count' // NEW
    ];
    for(const n of need){ if(tmap[n]==null) throw new Error('LeadTracker missing header: '+n); }

    // detect source columns
    const sHdr = srcVals[0];
    const sidx = detectSourceCols_(sHdr);
    if(sidx.phone === -1) throw new Error('SourceData: phone column not found.');

    // existing phones (Active duplicates avoid) -> from Tracker only
    const existing = new Set(trkVals.slice(1)
      .map(r => String(r[tmap['phone']]||'').trim())
      .filter(Boolean)
    );

    const fresh = [];
    for(let i=1;i<srcVals.length;i++){
      const r = srcVals[i];
      const ph = String(r[sidx.phone]||'').trim();
      if(!ph) continue;
      if(!existing.has(ph)) fresh.push(r);
    }
    if(!fresh.length) return;

    // 40/30/30 split
    let total = fresh.length;
    let counts = DISTRIBUTION.map(p=>Math.floor(p*total));
    counts[0] += total - counts.reduce((a,b)=>a+b,0);

    // Prepare next Lead ID sequence (across both sheets)
    const np = ensureNotPickedSheet_();
    let nextSeq = getNextLeadSeq_(trk, np, tmap);

    const toAppend = [];
    let k = 0;
    for(let s=0; s<SALES_PERSONS.length; s++){
      for(let j=0; j<counts[s]; j++){
        const r = fresh[k++]; if(!r) break;

        const phone = String(r[sidx.phone]||'').trim();
        if(!phone) continue;

        const row = new Array(trkHdr.length).fill('');
        const id  = formatLeadId_(nextSeq++);

        // ✅ previous allocations across BOTH sheets (irrespective of column letters)
        const prevCount = getPrevAllocationCountAcross_(phone, trk, np);
        const allocCount = (prevCount || 0) + 1;

        row[tmap['date']]             = (sidx.date>-1 ? r[sidx.date] : new Date());
        row[tmap['lead id']]          = id;
        row[tmap['name']]             = (sidx.name>-1 ? r[sidx.name] : '');
        row[tmap['phone']]            = phone;
        row[tmap['per hr shoot']] = (sidx.perHr > -1 ? r[sidx.perHr] : '');
        row[tmap['content you are planing']] = (sidx.content > -1 ? r[sidx.content] : '');
        row[tmap['do you need editing services']] = (sidx.editing > -1 ? r[sidx.editing] : '');
        row[tmap['allocation date']]  = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd/MM/yyyy');   // today = distribute day
        row[tmap['sales person']]     = SALES_PERSONS[s];
        row[tmap['call status']]      = '';           // blank initially
        row[tmap['calling date']]     = '';           // set on edit
        row[tmap['allocation count']] = allocCount;   // ✅ write count (X via header name)

        toAppend.push(row);
      }
    }

    if(toAppend.length){
      // Find the first empty row after the last row with data
let lastRow = trk.getLastRow();
while (lastRow > 0 && trk.getRange(lastRow, 1).isBlank()) {
  lastRow--;
}
const start = lastRow + 1;
trk.getRange(start, 1, toAppend.length, trkHdr.length).setValues(toAppend);

    }
  } finally {
    lock.releaseLock();
  }
}

/* =============== B) SWEEP / REDISTRIBUTE ONLY =================
   Rule: LeadTracker se woh saari rows jinka Call Status:
   - BLANK ho, ya
   - "Call Picked" ke ALAVA kuch bhi ho
   -> "Not Call Picked Leads" sheet me move + LeadTracker se delete.

   ✅ Header-based mapping so NP me column order different ho to bhi safe.
*/
function sweepNotPicked(){
  const ss  = SpreadsheetApp.getActive();
  const trk = ss.getSheetByName(SHEET_TRACKER);
  const np  = ensureNotPickedSheet_();
  if(!trk || !np) return;

  const trkHM = getHeaderMap_(trk);
  const npHM  = getHeaderMap_(np);
  if(!trkHM || !npHM) return;

  const H = trkHM.headers;
  const cmap = trkHM.cmap;
  const statusCol = cmap['call status'];
  if(statusCol==null) return;

  const data = trk.getDataRange().getValues();
  if (data.length < 2) return;

  // pick rows (blank OR not "call picked")
  const rowsToMoveIdx = [];
  const rowsToAppendMapped = [];

  for (let i = 1; i < data.length; i++) {
    const r  = data[i];
    const st = (String(r[statusCol]||'').trim().toLowerCase());
    if (st === '' || st !== 'call picked') {
      rowsToMoveIdx.push(i + 1);

      // map by header name from Tracker → NotPicked
      const out = new Array(np.getLastColumn()).fill('');
      for(const [name, npIdx] of Object.entries(npHM.cmap)){
        const trkIdx = cmap[name];
        if(trkIdx != null){
          out[npIdx] = r[trkIdx];
        }
      }
      rowsToAppendMapped.push(out);
    }
  }

  // append to Not Picked (mapped)
  if (rowsToAppendMapped.length) {
    const startNP = np.getLastRow() + 1;
    np.getRange(startNP, 1, rowsToAppendMapped.length, np.getLastColumn())
      .setValues(rowsToAppendMapped);
  }

  // delete from LeadTracker in reverse
  for (let i = rowsToMoveIdx.length - 1; i >= 0; i--) {
    trk.deleteRow(rowsToMoveIdx[i]);
  }
}

