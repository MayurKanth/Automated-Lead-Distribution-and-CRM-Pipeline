/**
 * Run once to install an EDIT trigger that calls bridgeOnEdit_ on every edit.
 * Isse tumhare existing simple onEdit(e) ko chhedna nahi padega.
 */
function installLeadBridgeTrigger_(){
  // Delete any old triggers of same handler
  ScriptApp.getProjectTriggers().forEach(t=>{
    if(t.getHandlerFunction() === 'bridgeOnEdit_'){
      ScriptApp.deleteTrigger(t);
    }
  });
  ScriptApp.newTrigger('bridgeOnEdit_')
    .forSpreadsheet(SpreadsheetApp.getActive())
    .onEdit()
    .create();
}

/**
 * Installable onEdit bridge — LeadTracker me "connected" hone par Clients tab update.
 */
function bridgeOnEdit_(e){
  try{
    if(!e || !e.range || !e.source) return;
    const ss = e.source;
    const sh = e.range.getSheet();
    if(!sh) return;

    // Sheet names from your config constants
    const LT = typeof SHEET_TRACKER !== 'undefined' ? SHEET_TRACKER : 'LeadTracker';
    if(sh.getName() !== LT) return; // Only react in LeadTracker

    // Read headers + col map
    const lastCol = sh.getLastColumn();
    if(lastCol < 1) return;
    const headers = sh.getRange(1,1,1,lastCol).getValues()[0];
    const cmap = colmap_(headers);  // uses your existing colmap_ helper

    const row = e.range.getRow();
    if(row < 2) return;

    // Columns we need (case-insensitive)
    const cStatusC = cmap['call status'];
    const leadIdC  = cmap['lead id'];
    const nameC    = cmap['name'] || cmap['lead name'] || cmap['client name'];
    const phoneC   = cmap['phone'] || cmap['phone number'] || cmap['mobile'];
    const salesC   = cmap['salesperson'] || cmap['sales person'] || cmap['assigned to'];

    if([cStatusC, leadIdC].some(v=>v==null)) return; // required

    // Row data
    const rowVals = sh.getRange(row,1,1,lastCol).getValues()[0];
    const status  = String(rowVals[cStatusC]||'').trim().toLowerCase();

    // Only on "connected"
    if(status !== 'connected') return;

    const leadId  = String(rowVals[leadIdC]||'').trim();
    if(!leadId) return;

    const clientId = 'C' + leadId;
    const name     = nameC!=null ? rowVals[nameC] : '';
    const phone    = phoneC!=null ? rowVals[phoneC] : '';
    const sales    = salesC!=null ? rowVals[salesC] : '';

    // Upsert into Clients sheet
    const csName = 'Clients';
    const cs = ss.getSheetByName(csName) || ss.insertSheet(csName);
    const cLastCol = Math.max(6, cs.getLastColumn());
    const Cheaders = cs.getRange(1,1,1,cLastCol).getValues()[0];

    // Ensure headers exist (idempotent)
    const need = ['client id','lead id','client name','phone','salesperson','connected date'];
    const cmapC = colmap_(Cheaders);
    need.forEach((h,i)=>{
      if(cmapC[h]==null){
        cs.getRange(1, cLastCol + i + 1).setValue(h.replace(/\b\w/g,m=>m.toUpperCase()));
      }
    });

    // Refresh header map (in case we extended)
    const H2 = cs.getRange(1,1,1,cs.getMaxColumns()).getValues()[0];
    const cm2 = colmap_(H2);
    const CID = cm2['client id'], LID = cm2['lead id'], CN = cm2['client name'],
          PH  = cm2['phone'],     SP  = cm2['salesperson'], CD = cm2['connected date'];

    if([CID,LID,CN,PH,SP,CD].some(v=>v==null)){
      throw new Error('Clients headers missing; ensure: Client ID, Lead ID, Client Name, Phone, Salesperson, Connected Date');
    }

    // Find existing by Client ID
    const lastRow = cs.getLastRow();
    let foundR = -1;
    if(lastRow >= 2){
      const rng = cs.getRange(2, CID+1, lastRow-1, 1).getValues(); // Client ID col only
      for(let i=0;i<rng.length;i++){
        if(String(rng[i][0]).trim() === clientId){
          foundR = 2 + i;
          break;
        }
      }
    }

    const now = new Date();
    if(foundR === -1){
      // append new
      cs.appendRow(Array(Math.max(CD,4)+1).fill('')); // safe widen
      const r = cs.getLastRow();
      cs.getRange(r, CID+1).setValue(clientId);
      cs.getRange(r, LID+1).setValue(leadId);
      cs.getRange(r, CN+1 ).setValue(name);
      cs.getRange(r, PH+1 ).setValue(phone);
      cs.getRange(r, SP+1 ).setValue(sales);
      cs.getRange(r, CD+1 ).setValue(now);
    }else{
      // update fields if changed
      cs.getRange(foundR, CN+1 ).setValue(name);
      cs.getRange(foundR, PH+1 ).setValue(phone);
      cs.getRange(foundR, SP+1 ).setValue(sales);
      if(!cs.getRange(foundR, CD+1).getValue()){
        cs.getRange(foundR, CD+1).setValue(now);
      }
    }
  }catch(err){
    // optional: Logger.log(err);
  }
}

function onEditSourceDataDate(e) {
  try {
    const sh = e.range.getSheet();
    if (sh.getName() !== SHEET_SOURCE) return; // Only run for SourceData

    const hdr = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0];
    const cmap = colmap_(hdr);
    const dateCol = (cmap['date'] || 0) + 1; // Get the column index for 'date'
    if (!dateCol) return; // Skip if 'date' column doesn't exist

    const editedRow = e.range.getRow();
    if (editedRow === 1) return; // Skip header row

    // Stamp the current date in the 'date' column for the edited row
    const dateValue = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd/MM/yyyy');
    sh.getRange(editedRow, dateCol).setValue(dateValue);
  } catch (err) {
    Logger.log('Error in onEditSourceDataDate: ' + err.toString());
  }
}

function installSourceDataDateTrigger() {
  // Delete any old triggers of the same handler
  ScriptApp.getProjectTriggers().forEach(t => {
    if (t.getHandlerFunction() === 'onEditSourceDataDate') {
      ScriptApp.deleteTrigger(t);
    }
  });

  // Create a new onEdit trigger for SourceData
  ScriptApp.newTrigger('onEditSourceDataDate')
    .forSpreadsheet(SpreadsheetApp.getActive())
    .onEdit()
    .create();
}


