function norm_(v){ return (v==null?'':String(v)).trim().toLowerCase(); }
function colmap_(hdr) {
  const map = {};
  hdr.forEach((h, i) => {
    const key = String(h || '').trim().toLowerCase().replace(/,/g, '');
    // Original columns
    if (key === "call status") map["call status"] = i;
    if (key === "calling date") map["calling date"] = i;
    if (key === "lead status") map["lead status"] = i;
    if (key === "lead id") map["lead id"] = i;
    if (key === "name") map["name"] = i;
    if (key === "phone") map["phone"] = i;
    if (key === "sales person") map["sales person"] = i;
    if ( key === "date") map["date"] = i; // This will match 'Date', 'DATE', etc.
    if (key === "per hr shoot" || key === "perhrshoot" || key === "per hour shoot") map["per hr shoot"] = i;
    if (key === "content you are planing") map["content you are planing"] = i;
    if (key === "do you need editing services") map["do you need editing services"] = i;
    if (key === "allocation date") map["allocation date"] = i;
    if (key === "allocation count") map["allocation count"] = i;



    // Remark & Date numbered columns (now up to 10)
    for (let n = 1; n <= 10; n++) {
      if (key === `remark ${n}`) map[`remark ${n}`] = i;
      if (key === `date ${n}`) map[`date ${n}`] = i;
      if (key === `call status ${n}`) map[`call status ${n}`] = i;
      if (key === `lead quality ${n}`) map[`lead quality ${n}`] = i;
    }
  });
  return map;
}




