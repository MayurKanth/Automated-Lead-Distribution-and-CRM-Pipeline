const SHEET_SOURCE = 'SourceData';
const SHEET_TRACKER = 'LeadTracker';
const SHEET_NOT_PICKED = 'Not Call Picked Leads';

const SALES_PERSONS = ['Lucky','Ayush'];   // order matters
const DISTRIBUTION = [0.5, 0.5];              // new leads distribution
const LEAD_ID_PREFIX = 'L';                         // e.g., L0001
const LEAD_ID_PAD = 4;                              // L0001, L0002, ...
