function handleEdit(e) {
  try {
    const sh = e.range.getSheet();
    if (sh.getName() !== 'LeadTracker') return;
    const hdr = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0];
    const cmap = colmap_(hdr);
    const r = e.range.getRow();
    const c = e.range.getColumn();
    const __d = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'dd/MM/yyyy');
    if (r === 1) return; // Skip header row

    // Loop through all possible remark columns (1-10)
    for (let n = 1; n <= 10; n++) {
      const remarkCol = (cmap[`remark ${n}`] || 0) + 1;
      const dateCol = (cmap[`date ${n}`] || 0) + 1;
      if (c === remarkCol) {
        const v = sh.getRange(r, remarkCol).getValue();
        if (String(v).trim() !== '') {
          sh.getRange(r, dateCol).setValue(__d);
        }
        break; // Exit loop after handling the edit
      }
    }

    // Handle Call Status updates
    const statusC = (cmap['call status'] || 0) + 1;
    const callDateC = (cmap['calling date'] || 0) + 1;
    if (c === statusC) {
      const v = norm_(e.range.getValue());
      if (v !== '') sh.getRange(r, callDateC).setValue(new Date());
    }

    // Handle "Connected" status (copy your existing logic here)
    const leadStatusC = (cmap['lead status'] || 0) + 1;
    if (c === leadStatusC) {
      const statusVal = norm_(e.range.getValue());
      if (statusVal === 'connected') {
        const rowVals = sh.getRange(r, 1, 1, sh.getLastColumn()).getValues()[0];
        const leadId = rowVals[cmap['lead id']] || '';
        if (!leadId) return;
        const clientId = 'C' + String(leadId);
        const clientName = rowVals[cmap['name']] || '';
        const phone = rowVals[cmap['phone']] || '';
        const salesPerson = rowVals[cmap['sales person']] || '';
        const connectedDate = new Date();
        const ss = SpreadsheetApp.getActive();
        const clientsSheet = ss.getSheetByName('Clients');
        if (!clientsSheet) return;
        const ch = clientsSheet.getRange(1, 1, 1, clientsSheet.getLastColumn()).getValues()[0].map(h => h.toLowerCase());
        const cidCol = ch.indexOf('client id');
        const nameCol = ch.indexOf('client name');
        const phoneCol = ch.indexOf('phone');
        const spCol = ch.indexOf('sales person');
        const dateCol = ch.indexOf('connected date');
        const out = new Array(clientsSheet.getLastColumn()).fill('');
        if (cidCol > -1) out[cidCol] = clientId;
        if (nameCol > -1) out[nameCol] = clientName;
        if (phoneCol > -1) out[phoneCol] = phone;
        if (spCol > -1) out[spCol] = salesPerson;
        if (dateCol > -1) out[dateCol] = connectedDate;
        clientsSheet.appendRow(out);
      }
    }
  } catch (err) {
    Logger.log('Error in handleEdit: ' + err.toString());
  }
}




/* =============== (OPTIONAL) BACKFILL =================
   Purane rows jinke Allocation Count blank hain, unhe fill karne ke liye
*/
function backfillAllocationCounts(){
  const ss  = SpreadsheetApp.getActive();
  const trk = ss.getSheetByName(SHEET_TRACKER);
  const np  = ss.getSheetByName(SHEET_NOT_PICKED);
  if(!trk) throw new Error('LeadTracker missing.');

  const H = trk.getRange(1,1,1,trk.getLastColumn()).getValues()[0];
  const cmap = colmap_(H);
  const phC = cmap['phone'], acC = cmap['allocation count'];
  if(phC==null || acC==null) throw new Error('Add "Allocation Count" header first.');

  const last = trk.getLastRow();
  if(last < 2) return;
  const rng = trk.getRange(2,1,last-1,trk.getLastColumn());
  const vals = rng.getValues();

  for(let i=0;i<vals.length;i++){
    const phone = String(vals[i][phC]||'').trim();
    if(!phone) continue;
    const prev = getPrevAllocationCountAcross_(phone, trk, np);
    const current = parseInt(vals[i][acC]||'0',10);
    if(!current){
      vals[i][acC] = Math.max(prev,1); // at least 1 if present in tracker
    }
  }
  rng.setValues(vals);
}


